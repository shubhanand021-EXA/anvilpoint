{
  "name": "forgekit",
  "version": "1.1.0",
  "private": true,
  "description": "FORGEKIT — Open-Source Project Readiness Workbench. Local-first repository analysis, documentation generation, and maintenance tooling.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "demo:shots": "node scripts/shots.cjs",
    "demo:gif": "python scripts/make-gif.py"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "^26.6.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.0.0",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "3.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
